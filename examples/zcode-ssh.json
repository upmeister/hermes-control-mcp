{
  "mcpServers": {
    "hermes": {
      "type": "stdio",
      "command": "ssh",
      "args": [
        "-T",
        "hermes-host",
        "/home/user/.local/bin/hermes-control-mcp",
        "--state-db",
        "/home/user/.local/state/hermes-control-mcp/zcode.db",
        "--log-level",
        "WARNING"
      ]
    }
  }
}
